# Environment variables for yuha_backend
# Copy this file to .env and fill in the real values — never commit .env to git

# ── Server ─────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── Supabase PostgreSQL ────────────────────────────────────────────────────────
# Transaction Pooler URL (port 6543) — works on all networks.
# Found at: Supabase Dashboard → Project Settings → Database → Connection string → Transaction pooler tab
# USERNAME must include the project ref:  postgres.[project-ref]
# If password has special chars (@ # % : /), percent-encode them: @ → %40
DATABASE_URL=postgresql://postgres.[project-ref]:[YOUR-PASSWORD]@aws-0-[region].pooler.supabase.com:5432/postgres

# ── Supabase project (for Storage client) ─────────────────────────────────────
# Found at: Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://[project-ref].supabase.co
# service_role key — server-side only, NEVER expose to frontend or commit to git
# Found at: Supabase Dashboard → Project Settings → API → service_role (starts with eyJ...)
SUPABASE_SERVICE_KEY=eyJ...

# ── Auth ───────────────────────────────────────────────────────────────────────
JWT_SECRET=replace_with_a_long_random_secret

# ── CORS ───────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173
