{
  "info": {
    "name": "Yuha Backend API",
    "description": "REST API for Yuha Exclusives jewellery store backend.\n\nBase URL: http://localhost:3000\n\nAll successful responses: { success: true, data: ... }\nAll error responses:    { success: false, error: { code, message }, requestId }",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "product_id",
      "value": "REPLACE-WITH-REAL-UUID",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/health",
              "host": ["{{base_url}}"],
              "path": ["api", "health"]
            },
            "description": "Server liveness check. Returns 200 if the Express server is running."
          }
        },
        {
          "name": "Debug — Supabase Connection",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/debug/supabase",
              "host": ["{{base_url}}"],
              "path": ["api", "debug", "supabase"]
            },
            "description": "⚠️ Temporary probe endpoint. Confirms DB connection is working. Remove before production."
          }
        }
      ]
    },
    {
      "name": "Catalog",
      "item": [
        {
          "name": "Get All Catalog",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/catalog",
              "host": ["{{base_url}}"],
              "path": ["api", "catalog"]
            },
            "description": "Returns all three lookup tables in one call: categories, finish_types, occasion_types. Use this to populate frontend filter dropdowns."
          }
        },
        {
          "name": "Get Categories",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/catalog/categories",
              "host": ["{{base_url}}"],
              "path": ["api", "catalog", "categories"]
            },
            "description": "Returns active categories: Necklaces, Chains, Chainsets, Pendants, Bracelets, Earrings, Bangles."
          }
        },
        {
          "name": "Get Finish Types",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/catalog/finish-types",
              "host": ["{{base_url}}"],
              "path": ["api", "catalog", "finish-types"]
            },
            "description": "Returns active finish types: Antique, Adstone, Gold, Rosegold."
          }
        },
        {
          "name": "Get Occasion Types",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/catalog/occasion-types",
              "host": ["{{base_url}}"],
              "path": ["api", "catalog", "occasion-types"]
            },
            "description": "Returns active occasion types: Festive, Casual."
          }
        }
      ]
    },
    {
      "name": "Products",
      "item": [
        {
          "name": "List Products",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/products",
              "host": ["{{base_url}}"],
              "path": ["api", "products"],
              "query": [
                { "key": "category",     "value": "Necklaces",  "disabled": true, "description": "Filter by category name" },
                { "key": "finish_type",  "value": "Gold",       "disabled": true, "description": "Filter by finish type name" },
                { "key": "occasion_type","value": "Festive",    "disabled": true, "description": "Filter by occasion type name" },
                { "key": "is_available", "value": "true",       "disabled": true, "description": "true | false" },
                { "key": "sort_by",      "value": "price_asc",  "disabled": true, "description": "price_asc | price_desc | newest" }
              ]
            },
            "description": "List all products. All query params are optional and combinable.\n\nQuery params:\n- category: filter by category name (e.g. Necklaces)\n- finish_type: filter by finish type name (e.g. Gold)\n- occasion_type: filter by occasion type name (e.g. Festive)\n- is_available: true | false\n- sort_by: price_asc | price_desc | newest (default)"
          }
        },
        {
          "name": "List Products — Filtered Example",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/products?category=Necklaces&finish_type=Gold&sort_by=price_asc&is_available=true",
              "host": ["{{base_url}}"],
              "path": ["api", "products"],
              "query": [
                { "key": "category",     "value": "Necklaces" },
                { "key": "finish_type",  "value": "Gold" },
                { "key": "sort_by",      "value": "price_asc" },
                { "key": "is_available", "value": "true" }
              ]
            },
            "description": "Example: active Gold Necklaces sorted cheapest first."
          }
        },
        {
          "name": "Get Product by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/products/{{product_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "products", "{{product_id}}"]
            },
            "description": "Get a single product by UUID. Returns 404 if not found.\n\nSet the product_id variable in the collection Variables tab."
          }
        },
        {
          "name": "Create Product — Minimal",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Gold Layered Necklace\",\n  \"price\": 1499\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/api/products",
              "host": ["{{base_url}}"],
              "path": ["api", "products"]
            },
            "description": "Create a product with only required fields: name and price."
          }
        },
        {
          "name": "Create Product — Full",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Antique Bangle Set\",\n  \"description\": \"Traditional antique finish bangle set with intricate design\",\n  \"short_description\": \"Antique finish bangle set\",\n  \"price\": 899,\n  \"offer_price\": 749,\n  \"offer_label\": \"17% off\",\n  \"stock_quantity\": 5,\n  \"delivery_time\": \"3-5 days\",\n  \"category_id\": \"REPLACE-WITH-CATEGORY-UUID\",\n  \"finish_type_id\": \"REPLACE-WITH-FINISH-TYPE-UUID\",\n  \"occasion_type_id\": \"REPLACE-WITH-OCCASION-TYPE-UUID\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/api/products",
              "host": ["{{base_url}}"],
              "path": ["api", "products"]
            },
            "description": "Create a product with all fields. Get category_id, finish_type_id, occasion_type_id from GET /api/catalog."
          }
        },
        {
          "name": "Update Product — Price & Stock",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"price\": 1299,\n  \"stock_quantity\": 8\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/api/products/{{product_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "products", "{{product_id}}"]
            },
            "description": "Update price and stock quantity. All fields are optional — only provided fields are updated."
          }
        },
        {
          "name": "Update Product — Deactivate",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"is_active\": false\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/api/products/{{product_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "products", "{{product_id}}"]
            },
            "description": "Deactivate a product (hide from storefront). Use is_active: true to reactivate."
          }
        },
        {
          "name": "Update Product — Add Offer",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"offer_price\": 999,\n  \"offer_label\": \"Sale\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/api/products/{{product_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "products", "{{product_id}}"]
            },
            "description": "Add or update a sale price and label on an existing product."
          }
        },
        {
          "name": "Delete Product",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/products/{{product_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "products", "{{product_id}}"]
            },
            "description": "Permanently delete a product. Returns 404 if UUID does not exist."
          }
        }
      ]
    }
  ]
}
